# --- Secrets -----------------------------------------------------------------
.env
*.key
config/credentials.yaml

# --- Experiment output -------------------------------------------------------
# Metrics CSVs, figures, Excel exports and run logs are regenerated from
# src/spot_factory_v2.py + analysis/. Not tracked.
results/
*.xlsx

# --- Simulation recordings ---------------------------------------------------
# `--record` writes one PNG per frame; a 10-lap run is several GB.
recordings/
frames/
*.mp4
*.avi

# --- Model weights -----------------------------------------------------------
# policies/spot_policy.pt is the exception: it is small and required to walk,
# so it is committed deliberately.
*.pt
*.pth
*.ckpt
*.bin
!policies/spot_policy.pt

