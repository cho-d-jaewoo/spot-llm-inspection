# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# These are read via os.getenv() in src/llm_decision.py. Either export them in
# your shell or load this file with something like `python-dotenv`.

# Required for the `haiku` and `sonnet` model aliases.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for the `gpt4o` alias (gpt-4o-mini).
# https://platform.openai.com
OPENAI_API_KEY=

# The `llama` alias talks to a local Ollama server — no key needed.
# Start it with `ollama serve && ollama pull llama3.1`.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: point asset lookups at a checkout other than this one.
# SPOT_REPO_ROOT=

# Optional: override Isaac Sim's extension cache location (sim/agv_factory_scene.py).
# ISAACSIM_EXTSCACHE=
